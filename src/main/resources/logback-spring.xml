<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ========== CONSOLE APPENDER (same as default) ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========== FILE APPENDER (writes to logs/foodwaste.log) ========== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/foodwaste.log</file>

        <!-- Roll the log file daily -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/foodwaste-%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Keep 7 days of log history -->
            <maxHistory>7</maxHistory>
            <!-- Cap total log size at 100MB -->
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========== ROOT LOGGER — logs to both console and file ========== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- Spring framework logs at WARN level (reduces noise) -->
    <logger name="org.springframework" level="WARN" />

    <!-- Your app logs at DEBUG level (more detail for your code) -->
    <logger name="com.foodwaste" level="DEBUG" />

</configuration>
